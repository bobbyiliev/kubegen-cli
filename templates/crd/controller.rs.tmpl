/// Cleanup resources when a {{kind}} is deleted
///
/// This is called when the resource has a deletion timestamp and we need
/// to clean up any external resources before removing the finalizer.
async fn cleanup_resource(resource: &{{kind}}, _ctx: &Context) -> Result<Action> {
    let name = resource.name_any();
    let namespace = resource.namespace().unwrap_or_default();

    info!("Cleaning up {{kind}} {}/{}", namespace, name);

    // TODO: Add your cleanup logic here
    // Examples:
    // - Delete external resources
    // - Remove entries from external databases
    // - Clean up cloud resources

    debug!("Cleanup completed for {{kind}} {}/{}", namespace, name);
    Ok(Action::await_change())
}

/// Update the status of a {{kind}} resource with a condition
async fn update_status(
    api: &Api<{{kind}}>,
    name: &str,
    condition_type: &str,
    status: &str,
    reason: &str,
    message: &str,
) -> Result<()> {
    let now = Utc::now().to_rfc3339();
    let status_patch = json!({
        "status": {
            "conditions": [{
                "type": condition_type,
                "status": status,
                "reason": reason,
                "message": message,
                "lastTransitionTime": now,
                "observedGeneration": 1
            }],
            "observedGeneration": 1
        }
    });

    api.patch_status(
        name,
        &PatchParams::apply("{{project_name}}"),
        &Patch::Merge(&status_patch),
    )
    .await
    .map_err(Error::KubeError)?;

    Ok(())
}

/// Handle errors during reconciliation
///
/// This function determines the requeue strategy based on the error type.
fn error_policy(resource: Arc<{{kind}}>, error: &Error, _ctx: Arc<Context>) -> Action {
    let name = resource.name_any();
    let namespace = resource.namespace().unwrap_or_default();

    // Log error with appropriate level based on error type
    match error {
        Error::KubeError(e) => {
            error!(
                namespace = %namespace,
                name = %name,
                error = %e,
                "Kubernetes API error during reconciliation"
            );
        }
        Error::FinalizerError(e) => {
            warn!(
                namespace = %namespace,
                name = %name,
                error = ?e,
                "Finalizer error during reconciliation"
            );
        }
        _ => {
            error!(
                namespace = %namespace,
                name = %name,
                error = ?error,
                "Reconciliation error"
            );
        }
    }

    // Determine requeue interval based on deletion state
    if resource.metadata.deletion_timestamp.is_some() {
        // Resource is being deleted, retry more frequently
        Action::requeue(DELETE_REQUEUE_INTERVAL)
    } else {
        Action::requeue(ERROR_REQUEUE_INTERVAL)
    }
}

/// Start the {{kind}} controller
///
/// This sets up the controller with the watcher configuration and starts
/// the reconciliation loop.
pub async fn run(client: Client) -> Result<()> {
    let api: Api<{{kind}}> = Api::all(client.clone());
    let ctx = Arc::new(Context { client });

    info!("Starting {{kind}} controller");

    Controller::new(api, watcher::Config::default())
        .run(reconcile, error_policy, ctx)
        .for_each(|res| async move {
            match res {
                Ok(o) => debug!("Reconciled {:?}", o),
                Err(e) => error!("Reconcile failed: {:?}", e),
            }
        })
        .await;

    Ok(())
}
