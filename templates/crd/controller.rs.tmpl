//! Controller for {{kind}} resources
//!
//! This module implements the reconciliation loop for {{kind}} custom resources.
//! The reconciler handles create, update, and delete events with proper error
//! handling, status updates, and requeue logic.

use std::sync::Arc;
use std::time::Duration;

use chrono::Utc;
use futures::StreamExt;
use kube::{
    api::{Api, Patch, PatchParams},
    client::Client,
    runtime::{
        controller::{Action, Controller},
        finalizer::{finalizer, Event as FinalizerEvent},
        watcher,
    },
    ResourceExt,
};
use serde_json::json;
use tracing::{debug, error, info, instrument, warn};

use crate::{{kind_snake}}::types::{{kind}};
use crate::error::{Error, Result};

/// Finalizer name for {{kind}} resources
pub const FINALIZER: &str = "{{group}}/{{kind_snake}}-finalizer";

/// Default requeue interval for successful reconciliations
const DEFAULT_REQUEUE_INTERVAL: Duration = Duration::from_secs(300);

/// Requeue interval after an error
const ERROR_REQUEUE_INTERVAL: Duration = Duration::from_secs(60);

/// Short requeue interval for resources being deleted
const DELETE_REQUEUE_INTERVAL: Duration = Duration::from_secs(5);

/// Context for the {{kind}} controller
pub struct Context {
    /// Kubernetes client
    pub client: Client,
}

/// Reconcile a {{kind}} resource
///
/// This function is called whenever a {{kind}} resource is created, updated, or deleted.
/// It uses finalizers to ensure proper cleanup of external resources.
#[instrument(skip(ctx, resource), fields(name = %resource.name_any(), namespace = resource.namespace()))]
async fn reconcile(resource: Arc<{{kind}}>, ctx: Arc<Context>) -> Result<Action> {
    let name = resource.name_any();
    let namespace = resource.namespace().unwrap_or_default();

    debug!("Starting reconciliation for {{kind}} {}/{}", namespace, name);

    let api: Api<{{kind}}> = Api::namespaced(ctx.client.clone(), &namespace);

    // Use finalizer to handle cleanup on deletion
    finalizer(&api, FINALIZER, resource, |event| async {
        match event {
            FinalizerEvent::Apply(resource) => reconcile_resource(&resource, &ctx, &api).await,
            FinalizerEvent::Cleanup(resource) => cleanup_resource(&resource, &ctx).await,
        }
    })
    .await
    .map_err(|e| Error::FinalizerError(Box::new(e)))
}

/// Reconcile a {{kind}} resource (apply phase)
///
/// This is called for create and update events.
async fn reconcile_resource(
    resource: &{{kind}},
    ctx: &Context,
    api: &Api<{{kind}}>,
) -> Result<Action> {
    let name = resource.name_any();
    let namespace = resource.namespace().unwrap_or_default();

    info!("Reconciling {{kind}} {}/{}", namespace, name);

    // TODO: Add your reconciliation logic here
    // Examples:
    // - Create or update owned resources (Deployments, Services, etc.)
    // - Sync with external systems
    // - Validate current state matches desired state

    // Update status to reflect current state
    update_status(api, &name, "Ready", "True", "ReconcileSucceeded", "Resource reconciled successfully").await?;

    debug!("Successfully reconciled {{kind}} {}/{}", namespace, name);
    Ok(Action::requeue(DEFAULT_REQUEUE_INTERVAL))
