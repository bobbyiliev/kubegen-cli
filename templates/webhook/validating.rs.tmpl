//! Validating admission webhook for {{kind}}
//!
//! This webhook validates {{kind}} resources before they are persisted.

use kube::core::admission::{AdmissionRequest, AdmissionResponse};
use kube::core::DynamicObject;
use tracing::{debug, warn};

/// Validate a {{kind}} resource
///
/// Returns an AdmissionResponse indicating whether the resource is valid.
pub fn validate(request: AdmissionRequest<DynamicObject>) -> AdmissionResponse {
    let name = request.name.clone();
    debug!("Validating {{kind}} '{}'", name);

    // Get the object being validated
    let object = match &request.object {
        Some(obj) => obj,
        None => {
            // DELETE operations may not have an object
            return AdmissionResponse::from(&request).allow();
        }
    };

    // TODO: Add your validation logic here
    // Example validations:
    // - Check required fields are present
    // - Validate field values are within acceptable ranges
    // - Ensure referenced resources exist
    // - Enforce naming conventions

    // Example: Validate that spec exists
    if object.data.get("spec").is_none() {
        warn!("{{kind}} '{}' is missing spec", name);
        return AdmissionResponse::from(&request).deny("spec is required");
    }

    // If all validations pass, allow the request
    debug!("{{kind}} '{}' passed validation", name);
    AdmissionResponse::from(&request).allow()
}
