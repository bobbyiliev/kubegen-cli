//! Mutating admission webhook for {{kind}}
//!
//! This webhook mutates {{kind}} resources before they are persisted.

use kube::core::admission::{AdmissionRequest, AdmissionResponse};
use kube::core::DynamicObject;
use serde_json::json;
use tracing::{debug, info};

/// Mutate a {{kind}} resource
///
/// Returns an AdmissionResponse with optional patches to apply.
pub fn mutate(request: AdmissionRequest<DynamicObject>) -> AdmissionResponse {
    let name = request.name.clone();
    debug!("Mutating {{kind}} '{}'", name);

    // Get the object being mutated
    let _object = match &request.object {
        Some(obj) => obj,
        None => {
            // DELETE operations may not have an object
            return AdmissionResponse::from(&request).allow();
        }
    };

    // TODO: Add your mutation logic here
    // Example mutations:
    // - Add default values for optional fields
    // - Inject sidecar containers
    // - Add labels or annotations
    // - Normalize field values

    // Example: Add a default label if not present
    let patches = vec![
        json!({
            "op": "add",
            "path": "/metadata/labels/managed-by",
            "value": "{{kind_snake}}-operator"
        }),
    ];

    info!("Applied {} mutations to {{kind}} '{}'", patches.len(), name);

    // Return response with patches
    AdmissionResponse::from(&request)
        .with_patch(json!(patches))
        .expect("valid patch")
}
